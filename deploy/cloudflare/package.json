{
  "name": "backyard-cloudflare",
  "version": "0.2.0",
  "private": true,
  "description": "Backyard on Cloudflare Workers (free plan): one Worker plus SQLite Durable Objects, Workers AI and optional R2 (SPEC §16).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "backyard-cloudflare": "bin/backyard-cloudflare.mjs"
  },
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "predev": "npm run sync",
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --env local",
    "pretest": "npm run sync",
    "test": "vitest run && node --test test/scripts/*.test.mjs",
    "test:worker": "vitest run",
    "test:scripts": "node --test test/scripts/*.test.mjs",
    "pretypecheck": "npm run sync",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/sync-assets.mjs --strict && wrangler deploy --dry-run --env= --outdir .wrangler/dist",
    "setup": "node bin/backyard-cloudflare.mjs setup",
    "cf": "node bin/backyard-cloudflare.mjs",
    "package": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
