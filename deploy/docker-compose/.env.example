# Backyard docker-compose settings. Create .env with fresh secrets:
#   ./init-env.sh backyard.acme.com        (or: ./init-env.sh localhost)
# or copy this file to .env and fill in the empty values by hand.

# --- Required -----------------------------------------------------------------

# Hub at https://<domain>/, sites at https://<site>.<domain>/ (needs a wildcard
# DNS record *.<domain> pointing at this machine; "localhost" works locally).
BACKYARD_DOMAIN=localhost
# Signs sessions, API tokens, deploy ids and upload URLs (>= 32 characters):
#   openssl rand -hex 32
BACKYARD_SECRET=
# Database password (URL-safe characters only): openssl rand -hex 16
POSTGRES_PASSWORD=
# SHA-256 of the deploy token (the token itself is never stored):
#   TOKEN=byd_$(openssl rand -hex 24); printf %s "$TOKEN" | sha256sum
BACKYARD_DEPLOY_TOKEN_SHA256=

# --- Optional -----------------------------------------------------------------

# Public URL; default https://$BACKYARD_DOMAIN. Include the port when
# HTTPS_PORT is not 443, e.g. https://localhost:8443
BACKYARD_PUBLIC_URL=
BACKYARD_NAME=Backyard
# Container image (pin a version in production, e.g. ghcr.io/thasami/backyard:0.1.0).
BACKYARD_IMAGE=ghcr.io/thasami/backyard:latest
# Ports published by Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# TLS for the hub and *.<domain>: internal | on_demand | files | dns (see Caddyfile).
BACKYARD_TLS=internal
# Extra Caddy global options, e.g. the ACME contact: CADDY_GLOBAL_OPTIONS=email ops@acme.com
CADDY_GLOBAL_OPTIONS=
# Directory with fullchain.pem + privkey.pem for BACKYARD_TLS=files.
CADDY_CERTS_DIR=./certs

# Anyone who can reach the server may deploy without a token (auth.mode none
# only). Keep false unless this is a private playground.
BACKYARD_ALLOW_ANONYMOUS_DEPLOY=false

# Where sites live: a named volume (default) or a host path for rsync deploys,
# e.g. /srv/backyard/data (owned by uid 65532, see README.md).
BACKYARD_DATA=backyard-data
# Advertised to CLIs for `backyard deploy --method rsync`,
# e.g. backyard@backyard.acme.com:   (SSH user restricted with rrsync)
BACKYARD_RSYNC_TARGET=

# Single sign-on (uncomment the oidc block in backyard.yaml).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# AI providers (uncomment the ai block in backyard.yaml).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
